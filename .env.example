# ── DeepSeek API (必填) ──
# 注册获取: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── DeepSeek API 地址 (可选，默认 https://api.deepseek.com) ──
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 模型名 ──
# 必须是服务端实际提供的模型。当前端点只提供 deepseek-flash 与 deepseek-v4-pro。
#
# 注意两者都是**推理模型**：会先产出不可见的 reasoning_content，再给正文。
# 因此代码里的 max_tokens 必须留足余量 —— 预算不足时正文直接为空字符串，
# 且 finish_reason 为 "length"，看起来像"模型没回答"。
#   实测 deepseek-v4-pro，1024 预算 → 推理 1102 字、正文 850 字被截断；
#       3072 预算 → 正常返回完整答案。
#   deepseek-flash 在同样预算下推理不收敛，正文始终为空，不可用于问答。
DEEPSEEK_MODEL=deepseek-v4-pro

# ── HuggingFace 镜像 (国内用户建议设置) ──
# 解决模型下载被墙问题
HF_ENDPOINT=https://hf-mirror.com
